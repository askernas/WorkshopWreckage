		"zone_restored_50": 60,
		"zone_restored_75": 80,
		"zone_restored_100": 150,
		"discover_definition": 1,
		"discover_robot_part": 25,
		"robot_repaired": 300,
		"objective_completed": 100
	},
	"anti_exploit": {
		"sort_xp_once_per_instance": true,
		"discover_xp_once_per_definition": true,
		"no_xp_for_pickup_or_drop": true,
		"comment": "Picking up and dropping items never grants XP; sorting grants XP only the first time an instance is stored, so taking an item out of storage and re-storing it gives nothing."
	},
	"preset_xp_scale": {
		"standard": 1.0,
		"large": 0.62,
		"massive": 0.45,
		"comment": "Per-item XP shrinks with world size so level 25 is reached at a similar completion fraction in every preset. Balance target: Massive completes in ~1.8x Standard's time (items x2.44)."
	},
