# Only the source code and files needed to build the game are in git (2026-11-02):
# the Unity project and the game data it copies into the build (shared/data, shared/meshes).
# Everything else (docs, HISTORY, CLAUDE.md, reference images, tools, the old Godot project, QA output) stays on disk only.
/*
!/.gitignore
!/.gitattributes
!/WorkshopWreckage_Unity/
!/shared/
/shared/*
!/shared/data/
!/shared/meshes/

# Unity: generated, local or build output
WorkshopWreckage_Unity/[Ll]ibrary/
WorkshopWreckage_Unity/[Tt]emp/
WorkshopWreckage_Unity/[Oo]bj/
WorkshopWreckage_Unity/[Bb]uild/
WorkshopWreckage_Unity/[Bb]uilds/
WorkshopWreckage_Unity/[Ll]ogs/
WorkshopWreckage_Unity/[Uu]ser[Ss]ettings/
WorkshopWreckage_Unity/.vs/
WorkshopWreckage_Unity/Assets/StreamingAssets/
WorkshopWreckage_Unity/Assets/StreamingAssets.meta
*.csproj
*.sln
*.slnx
__pycache__/
*.pyc
